{
  "name": "trae-agent-anthropic-proxy-demo",
  "version": "1.0.0",
  "description": "Demo workspace for using Trae Agent with Anthropic through a localhost proxy",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "npm run build && node dist/index.js",
    "dev": "tsc --watch & nodemon dist/index.js",
    "clean": "rm -rf dist",
    "test-cli": "npx tsx test-cli.ts"
  },
  "keywords": [
    "trae-agent",
    "anthropic",
    "proxy",
    "claude",
    "typescript"
  ],
  "author": "Trae AI",
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.30.1",
    "https-proxy-agent": "^7.0.5",
    "http-proxy-agent": "^7.0.2"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0",
    "nodemon": "^3.0.0",
    "tsx": "^4.0.0"
  }
}
